APP_NAME=Enterprise Knowledge Agent
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# OpenAI-compatible chat API. DeepSeek works with:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
