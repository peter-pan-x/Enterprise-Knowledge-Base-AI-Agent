APP_NAME=Enterprise Knowledge Agent
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# OpenAI-compatible chat API. DeepSeek works with:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# Stage 3 basic RAG settings.
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
EMBEDDING_DIMENSION=384
